# Copy to deploy/lightsail/.env on the server (never commit .env).
#   cp deploy/lightsail/.env.example deploy/lightsail/.env

# ── Server / proxy ──────────────────────────────────────────
# Public hostname for Caddy TLS (required if you use --proxy).
DOMAIN=api.example.com
# Host port when NOT using Caddy (default 3000). With --proxy leave 3000 internal only
# or set API_PUBLISH_PORT= to empty and use compose override — simplest: use --proxy.
API_PUBLISH_PORT=3000

# Public API base used in emails (approve links, etc.). Include /api suffix.
API_URL=https://api.example.com/api

# ── App ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Supabase Postgres — use Transaction pooler :6543 (IPv4). See apps/backend/AGENTS.md
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Redis password for the compose redis service (deploy.sh injects REDIS_URL).
REDIS_PASSWORD=generate-a-long-random-string

# If you use managed Redis instead of compose, set full URL and still keep redis
# service or remove it from compose. Example Upstash:
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Resend (required in production — validateEnv)
RESEND_API_KEY=re_...
EMAIL_FROM=Lifty <noreply@example.com>
ADMIN_EMAIL=ops@example.com

# CORS — native apps don't need it; useful for Expo web / admin.
CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Geo (public defaults OK early; self-host later)
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org

# Optional integrations
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_API_URL=https://verification.didit.me/v3
DIDIT_WORKFLOW_ID=
DIDIT_CALLBACK_URL=https://example.com/kyc/callback
FCM_SERVICE_ACCOUNT_JSON=
