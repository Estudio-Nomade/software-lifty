{
  "expo": {
    "name": "Lifty Passenger",
    "slug": "lifty-passenger",
    "version": "1.0.2",
    "scheme": "lifty-passenger",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lifty.passenger",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSPhotoLibraryUsageDescription": "Lifty necesita acceso a tu galer\u00eda para la foto de perfil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF7F6"
      },
      "package": "com.lifty.passenger",
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "mode": "development"
        }
      ],
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF7F6",
          "image": "./assets/splash-brand.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-brand.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF7F6"
    }
  }
}
