{
  "expo": {
    "name": "Lifty",
    "slug": "lifty-passenger",
    "version": "1.0.2",
    "scheme": "lifty-passenger",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/97a435a9-6725-4207-a930-c11ec77c7de5",
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lifty.passenger",
      "infoPlist": {
        "NSCameraUsageDescription": "Lifty necesita la cámara para tu foto de perfil.",
        "NSPhotoLibraryUsageDescription": "Lifty necesita acceso a tu galería para la foto de perfil.",
        "NSLocationWhenInUseUsageDescription": "Lifty usa tu ubicación para ubicar el origen del viaje y mostrarte conductores cercanos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF7F6"
      },
      "package": "com.lifty.passenger",
      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF7F6",
          "image": "./assets/splash-brand.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lifty usa tu ubicación para ubicar el origen del viaje y mostrarte conductores cercanos.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lifty necesita acceso a tu galería para la foto de perfil.",
          "cameraPermission": "Lifty necesita la cámara para tu foto de perfil."
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-brand.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF7F6"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97a435a9-6725-4207-a930-c11ec77c7de5"
      }
    },
    "owner": "martiyaquinta"
  }
}
