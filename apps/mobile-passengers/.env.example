EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base (must end with /api).
# EXPO_PUBLIC_API_URL wins over auto host detection in client.ts.
#
# Lab local (required while Railway is down):
#   1. Backend up: curl -sS http://127.0.0.1:3001/health → 200 status:ok
#   2. Expo Go on phone: EXPO_PUBLIC_API_URL=http://<wlan0-LAN-IP>:3001/api
#      (never 127.0.0.1 from the phone; never waydroid 192.168.240.x)
#   3. Web on same PC: http://127.0.0.1:3001/api is OK
#   4. Restart Metro after edits (bun run dev:passenger:clear if env cached)
#
# If GET {host}/health is not 200 (or body is "Application not found"),
# DO NOT use that URL — fare/directions/geocode will all 404.
#
# EAS preview/production may inject Railway via eas.json — only when
# https://…railway.app/health returns 200.
EXPO_PUBLIC_API_PORT=3001
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3001/api
# EXPO_PUBLIC_API_URL=https://liftybackend-production.up.railway.app/api

# Signup confirmation OTP is sent by Supabase Auth (not backend Resend).
# Delivery / SMTP / templates: docs/auth-signup-email.md
