EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional legacy fallback (only if publishable is unset):
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Backend — optional in local Expo Go (auto host:port).
# EAS preview/production inject the VPS API via eas.json:
#   EXPO_PUBLIC_API_URL=https://api.liftyviajes.com/api
EXPO_PUBLIC_API_PORT=3001
# EXPO_PUBLIC_API_URL=https://api.liftyviajes.com/api

# Signup confirmation OTP is sent by Supabase Auth (not backend Resend).
# Delivery / SMTP / templates: docs/auth-signup-email.md
