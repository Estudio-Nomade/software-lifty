# Supabase — copy from Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend API — optional in local Expo Go (auto host:port).
# EAS preview/production inject Railway via eas.json:
#   EXPO_PUBLIC_API_URL=https://liftybackend-production.up.railway.app/api
EXPO_PUBLIC_API_PORT=3001
# EXPO_PUBLIC_API_URL=https://liftybackend-production.up.railway.app/api

# Signup confirmation OTP is sent by Supabase Auth (not backend Resend).
# Delivery / SMTP / templates: docs/auth-signup-email.md
