{
  "expo": {
    "name": "Lifty Conductor",
    "slug": "lifty-app",
    "version": "1.0.2",
    "scheme": "lifty",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/90f11dff-37cf-4b27-b6e8-598491a871c5",
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lifty.conductor",
      "infoPlist": {
        "NSCameraUsageDescription": "Lifty necesita la cámara para fotos de perfil y documentación del conductor.",
        "NSPhotoLibraryUsageDescription": "Lifty necesita acceso a tu galería para foto de perfil y documentación.",
        "NSLocationWhenInUseUsageDescription": "Lifty usa tu ubicación para mostrarte en el mapa, recibir viajes cercanos y navegar hacia el pasajero."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF7F6"
      },
      "package": "com.lifty.conductor",
      "versionCode": 3,
      "navigationBar": {
        "backgroundColor": "#FFFFFF",
        "barStyle": "dark-content"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF7F6",
          "image": "./assets/splash-brand.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lifty usa tu ubicación para mostrarte en el mapa, recibir viajes cercanos y navegar hacia el pasajero.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lifty necesita acceso a tu galería para foto de perfil y documentación.",
          "cameraPermission": "Lifty necesita la cámara para fotos de perfil y documentación del conductor."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-brand.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF7F6"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90f11dff-37cf-4b27-b6e8-598491a871c5"
      }
    },
    "owner": "martiyaquinta"
  }
}
