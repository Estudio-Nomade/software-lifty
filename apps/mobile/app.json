{
  "expo": {
    "name": "Lifty",
    "slug": "lifty-app",
    "version": "1.0.2",
    "scheme": "lifty",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lifty.conductor",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "Lifty necesita la camara para verificar tu identidad con Didit.",
        "NSMicrophoneUsageDescription": "Lifty necesita el microfono para la verificacion biometrica de Didit."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF7F6"
      },
      "package": "com.lifty.conductor",
      "versionCode": 3,
      "usesCleartextTraffic": true,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "navigationBar": {
        "backgroundColor": "#FFFFFF",
        "barStyle": "dark-content"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "mode": "development"
        }
      ],
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lifty necesita la camara para verificar tu identidad y subir documentos.",
          "microphonePermission": "Lifty necesita el microfono para la verificacion biometrica de Didit.",
          "photosPermission": "Lifty necesita acceso a tus fotos para subir documentos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lifty necesita tu ubicacion para mostrarte en el mapa, navegar viajes y conectarte con pasajeros cercanos.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF7F6",
          "image": "./assets/splash-brand.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-brand.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF7F6"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90f11dff-37cf-4b27-b6e8-598491a871c5"
      }
    },
    "owner": "martiyaquinta"
  }
}
