PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://lifty:lifty@localhost:5432/lifty
REDIS_URL=redis://localhost:6379
# Public base URL of this API (used in admin approve email links).
# Dev default via bun run setup / syncDevPorts is usually :3001.
# LAN example: http://192.168.1.10:3001/api
# If unset, notifyAdminNewDriver falls back to http://localhost:3000/api (legacy).
API_URL=http://localhost:3001/api
# Supabase Auth issuer MUST match panels (admin + web-transito).
# Canonical Lifty project: https://wabddbkwugepkwrgzhpk.supabase.co
# Publishable key for auth (sb_publishable_... / anon); secret for storage/admin only server-side.
SUPABASE_URL=https://wabddbkwugepkwrgzhpk.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Include Vite local ports + Vercel admin/tránsito production origins (comma-separated).
# Example: http://localhost:5173,http://localhost:5174,https://lifty-admin-beta.vercel.app,https://<web-transito>.vercel.app
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
PHOTON_URL=https://photon.komoot.io
OSRM_URL=https://router.project-osrm.org
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# DIDIT verification API base (v3). See https://docs.didit.me
DIDIT_API_URL=https://verification.didit.me/v3
# Published workflow UUID from the DIDIT console (Workflows). KYC type.
DIDIT_WORKFLOW_ID=
# URL DIDIT redirects to when the hosted flow finishes (mobile detects this).
DIDIT_CALLBACK_URL=https://liftyviajes.com/kyc/callback
FCM_SERVICE_ACCOUNT_JSON=
# Send push notifications in development (default false). Set true to deliver
# to real devices (Expo Go / physical) while iterating.
SEND_PUSH_IN_DEV=true
# Web Push (PWA admin). Generate with: npx web-push generate-vapid-keys
# Public key may also be baked as VITE_VAPID_PUBLIC_KEY in lifty-admin.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@liftyviajes.com
# Optional deep-link base for admin PWA notification click (no trailing slash).
ADMIN_APP_URL=http://localhost:5174
# Web push in dev (default off unless SEND_PUSH_IN_DEV or this is true).
SEND_WEB_PUSH_IN_DEV=false
# Email (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Lifty <noreply@lifty.app>
# Send transactional emails in development (default false). Set true to deliver
# via Resend while iterating (admin new-driver notify, approve/reject, etc.).
# OTP/signup confirmation codes are NOT sent by this backend — they go through
# Supabase Auth (Dashboard SMTP / templates). See docs/auth-signup-email.md.
SEND_EMAILS_IN_DEV=false
# Admin approval email recipient (comma-separated for multiple)
ADMIN_EMAIL=liftyviajes@gmail.com
# Server-to-server secret for web-tránsito → POST /api/internal/transit/identification/issue
# Shared with web-tránsito server only (never VITE_* / mobile). Placeholder — set locally.
TRANSIT_BRIDGE_SECRET=
