{
  "name": "lifty",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "setup": "bun run --cwd apps/backend setup",
    "dev": "bun run scripts/dev-all.ts",
    "dev:backend": "bun run --filter @lifty/backend dev",
    "dev:driver": "bun run --filter @lifty/mobile dev",
    "dev:driver:clear": "bun run --filter @lifty/mobile dev:clear",
    "dev:driver:web": "bun run --filter @lifty/mobile web",
    "dev:passenger": "bun run --filter @lifty/mobile-passengers dev",
    "dev:passenger:clear": "bun run --filter @lifty/mobile-passengers dev:clear",
    "dev:passenger:web": "bun run --filter @lifty/mobile-passengers web",
    "eas:login": "bunx eas-cli login",
    "eas:whoami": "bunx eas-cli whoami",
    "eas:env:push": "bun run scripts/eas-push-preview-env.ts",
    "eas:build:android:preview": "bun run eas:build:android:preview:driver && bun run eas:build:android:preview:passenger",
    "eas:build:android:preview:driver": "bash scripts/eas-build-android-preview.sh apps/mobile",
    "eas:build:android:preview:passenger": "bash scripts/eas-build-android-preview.sh apps/mobile-passengers",
    "eas:build:android:production": "bun run eas:build:android:production:driver && bun run eas:build:android:production:passenger",
    "eas:build:android:production:driver": "bash scripts/eas-build-android-production.sh apps/mobile",
    "eas:build:android:production:passenger": "bash scripts/eas-build-android-production.sh apps/mobile-passengers",
    "eas:update:preview:driver": "bash scripts/eas-update.sh apps/mobile preview",
    "eas:update:preview:passenger": "bash scripts/eas-update.sh apps/mobile-passengers preview",
    "eas:update:preview": "bash scripts/eas-update-both.sh preview",
    "eas:update:production:driver": "bash scripts/eas-update.sh apps/mobile production",
    "eas:update:production:passenger": "bash scripts/eas-update.sh apps/mobile-passengers production",
    "eas:update:production": "bash scripts/eas-update-both.sh production",
    "build": "turbo build",
    "test": "turbo test --filter=@lifty/backend",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run lint && bun run typecheck",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "eas-cli": "^16.28.0",
    "lefthook": "^2.1.9",
    "qrcode-terminal": "0.11.0",
    "turbo": "^2.4.0"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@supabase/server": "^1.3.0"
  }
}
